    "version": "0.5.5",
    "version_from": [
      "CMakeLists.txt",
      "project\\(HELIX VERSION ([0-9.]+)"
    ],
    "plugin": "helix-desktop",
    "copy": [
      [
        "helix-core/src",
        "third_party/helix-core/src"
      ],
      [
        "helix-core/include",
        "third_party/helix-core/include"
      ],
      [
        "helix-core/third_party",
        "third_party/helix-core/third_party"
      ]
    ],
    "patched": [
      "helix-core/include/helix/Halfband.h",
      "helix-core/src/TableLibrary.cpp",
      "helix-core/third_party/charosc/dreadbass.h",
      "helix-core/third_party/dnfx/dn_fx.c",
      "helix-core/third_party/dnfx/dn_fxc.c"
