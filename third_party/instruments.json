{
  "_about": "Instruments copied in from Jamie's other repos. tools/check_instruments.py compares each 'commit' with the repo's newest; tools/check_instruments.py --update NAME copies the new code in. Always copy from the AU/VST plug-in build when the repo has one ('plugin'), so Paula plays what the plug-in plays.",
  "choppage": {
    "name": "CHOPPAGE",
    "repo": "TwistedGenetics/Choppage",
    "commit": "27392498b0525ccc8b96aef85331e21b9469ef1e",
    "version": "0.17.2",
    "version_from": [
      "CMakeLists.txt",
      "project\\(Choppage VERSION ([0-9.]+)"
    ],
    "plugin": "choppage-desktop",
    "copy": [
      [
        "choppage-core/src",
        "third_party/choppage/src"
      ],
      [
        "choppage-core/include",
        "third_party/choppage/include"
      ],
      [
        "choppage-core/third_party/velociloops",
        "third_party/choppage/third_party/velociloops"
      ],
      [
        "choppage-desktop/Source",
        "third_party/choppage/desktop"
      ]
    ],
    "rename": [
      [
        "PluginProcessor.",
        "ChoppageProcessor."
      ],
      [
        "PluginEditor.",
        "ChoppageEditor."
      ],
      [
        "UI/",
        "ChopUI/"
      ]
    ],
    "rewrite": [
      [
        "#include \"PluginProcessor.h\"",
        "#include \"ChoppageProcessor.h\""
      ],
      [
        "#include \"PluginEditor.h\"",
        "#include \"ChoppageEditor.h\""
      ],
      [
        "#include \"UI/",
        "#include \"ChopUI/"
      ]
    ],
    "patched": [
      "choppage-desktop/Source/PluginProcessor.h",
      "choppage-desktop/Source/PluginProcessor.cpp"
    ]
  },
  "helix": {
    "name": "HELIX",
