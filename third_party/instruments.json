  },
  "crafty": {
    "name": "CRAFTY",
    "repo": "TwistedGenetics/Crafty-Synth",
    "commit": "0a2898f8564b9c25600abdf4db7f49597b5186da",
    "version": "0.21",
    "version_from": [
      "VERSION",
      "([0-9.]+)"
    ],
    "plugin": "ports/plugin",
    "copy": [
      [
        "src/core",
        "third_party/crafty/core"
